{
    "name": "ec-sugar/plugin-favorites",
    "description": "EC-SUGAR 公式の App: お気に入り（会員が商品にハートを付けてマイページで見返す。値下げ・再入荷を選んだ人に知らせる）",
    "type": "library",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Fivenine design"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "EcSugar\\PluginFavorites\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcSugar\\PluginFavorites\\FavoritesServiceProvider"
            ]
        },
        "ec-sugar": {
            "type": "plugin",
            "name": "favorites",
            "plugin_api": 1,
            "core": "^1.0",
            "category": "customers"
        }
    }
}
