{
    "name": "ec-sugar/plugin-services",
    "description": "EC-SUGAR 公式の App: サービスの販売（設置の代行・作業の請け負いなど、物を送らない役務を、オプションつきでふだんのカートと注文の流れで売る）",
    "type": "library",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Fivenine design"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "EcSugar\\PluginServices\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcSugar\\PluginServices\\ServicesServiceProvider"
            ]
        },
        "ec-sugar": {
            "type": "plugin",
            "name": "services",
            "plugin_api": 1,
            "core": "^1.0",
            "category": "selling"
        }
    }
}
