{
    "name": "ec-sugar/plugin-bundle",
    "description": "EC-SUGAR 公式の App: セット商品（複数の品をまとめて 1 つの値段で売り、在庫は構成する品から引く）",
    "type": "library",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Fivenine design"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "EcSugar\\PluginBundle\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcSugar\\PluginBundle\\BundleServiceProvider"
            ]
        },
        "ec-sugar": {
            "type": "plugin",
            "name": "bundle",
            "plugin_api": 1,
            "core": "^1.0",
            "category": "selling"
        }
    }
}
