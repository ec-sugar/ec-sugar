{
    "name": "ec-sugar/plugin-product-csv",
    "description": "EC-SUGAR の App: 商品の CSV（商品・種類・在庫・写真の書き出しと取り込み）",
    "type": "library",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Fivenine design"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "EcSugar\\PluginProductCsv\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcSugar\\PluginProductCsv\\ProductCsvServiceProvider"
            ]
        },
        "ec-sugar": {
            "type": "plugin",
            "name": "product-csv",
            "plugin_api": 1,
            "core": "^1.0",
            "category": "products"
        }
    }
}
