{
    "name": "ec-sugar/plugin-preorder",
    "description": "EC-SUGAR 公式の App: 予約販売（発売前の商品の予約を受け付け、発売日にまとめて発送する。ADR 0073）",
    "type": "library",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Fivenine design"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "EcSugar\\PluginPreorder\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcSugar\\PluginPreorder\\PreorderServiceProvider"
            ]
        },
        "ec-sugar": {
            "type": "plugin",
            "name": "preorder",
            "plugin_api": 1,
            "core": "^1.0",
            "category": "selling"
        }
    }
}
