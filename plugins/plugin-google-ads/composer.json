{
    "name": "ec-sugar/plugin-google-ads",
    "description": "EC-SUGAR の App: Google 広告（gtag.js）。広告から来たお客さんの購入をコンバージョンとして計測する（ADR 0034）",
    "type": "library",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Fivenine design"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "EcSugar\\PluginGoogleAds\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcSugar\\PluginGoogleAds\\GoogleAdsServiceProvider"
            ]
        },
        "ec-sugar": {
            "type": "plugin",
            "name": "google-ads",
            "plugin_api": 1,
            "core": "^1.0",
            "category": "marketing",
            "settings": {
                "conversion_id": {
                    "type": "text",
                    "label": "コンバージョン ID",
                    "help": "AW- で始まり数字が続く ID（例: AW-123456789）。Google 広告の「目標」→「コンバージョン」で購入のアクションを開き、「タグを設定する」で見られます。",
                    "pattern": "AW-[0-9]{6,15}",
                    "max": 18,
                    "required": true
                },
                "conversion_label": {
                    "type": "text",
                    "label": "コンバージョンラベル",
                    "help": "同じ画面の send_to の「/」の後ろの英数字（例: AbC-D_efG-h12_34-567）。",
                    "pattern": "[A-Za-z0-9_-]{1,64}",
                    "max": 64,
                    "required": true
                }
            },
            "disclosure": [
                {
                    "company": "Google LLC",
                    "data": "見たページの URL、参照元の URL、端末とブラウザの情報、Cookie の識別子、広告のクリックの識別子、購入したときの注文の番号・金額・通貨",
                    "purpose": "広告の効果の測定（Google 広告のコンバージョン）",
                    "policy": "https://policies.google.com/privacy?hl=ja"
                }
            ],
            "storefront": {
                "scripts": [
                    {
                        "file": "google-ads.js",
                        "pages": ["general", "purchase"]
                    }
                ],
                "csp": {
                    "script-src": ["https://www.googletagmanager.com", "https://www.googleadservices.com", "https://www.google.com"],
                    "connect-src": ["https://www.googletagmanager.com", "https://www.googleadservices.com", "https://googleads.g.doubleclick.net", "https://pagead2.googlesyndication.com", "https://www.google.com", "https://www.google.co.jp", "https://ad.doubleclick.net"],
                    "img-src": ["https://www.googletagmanager.com", "https://www.googleadservices.com", "https://googleads.g.doubleclick.net", "https://pagead2.googlesyndication.com", "https://www.google.com", "https://www.google.co.jp"],
                    "frame-src": ["https://www.googletagmanager.com"]
                },
                "consent": ["ads"]
            }
        }
    }
}
