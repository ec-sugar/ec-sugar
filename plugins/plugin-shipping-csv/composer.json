{
    "name": "ec-sugar/plugin-shipping-csv",
    "description": "EC-SUGAR の App: 配送の CSV（運送会社の送り状ソフト向けに注文を書き出し、送り状番号の CSV を取り込んで発送済みにする）",
    "type": "library",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "authors": [
        {
            "name": "Fivenine design"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "autoload": {
        "psr-4": {
            "EcSugar\\PluginShippingCsv\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EcSugar\\PluginShippingCsv\\ShippingCsvServiceProvider"
            ]
        },
        "ec-sugar": {
            "type": "plugin",
            "name": "shipping-csv",
            "plugin_api": 1,
            "core": "^1.0",
            "category": "shipping",
            "settings": {
                "shipper_name": {
                    "type": "text",
                    "label": "ご依頼主の名前",
                    "help": "送り状のご依頼主（荷送人）に出す名前。空なら店の名前を使います。",
                    "pattern": "[^\\n]{1,40}",
                    "max": 40
                },
                "shipper_zip": {
                    "type": "text",
                    "label": "ご依頼主の郵便番号",
                    "help": "7 桁の郵便番号（例: 150-0001）。空なら特定商取引法の表記の「所在地」から読み取ります。",
                    "pattern": "[0-9]{3}-?[0-9]{4}",
                    "max": 8
                },
                "shipper_address": {
                    "type": "text",
                    "label": "ご依頼主の住所",
                    "help": "都道府県から入れます。空なら特定商取引法の表記の「所在地」を使います。",
                    "pattern": "[^\\n]{1,100}",
                    "max": 100
                },
                "shipper_phone": {
                    "type": "text",
                    "label": "ご依頼主の電話番号",
                    "help": "半角の数字とハイフン（例: 03-1234-5678）。空なら特定商取引法の表記の「電話番号」を使います。",
                    "pattern": "[0-9]{2,5}-?[0-9]{1,4}-?[0-9]{3,4}",
                    "max": 13
                },
                "yamato_billing_code": {
                    "type": "text",
                    "label": "ヤマト運輸のご請求先顧客コード",
                    "help": "B2 クラウドの請求先の顧客コード（半角の数字 10〜12 桁）。空なら B2 クラウドの既定の請求先になります。",
                    "pattern": "[0-9]{10,12}",
                    "max": 12
                },
                "yamato_freight_code": {
                    "type": "text",
                    "label": "ヤマト運輸の運賃管理番号",
                    "help": "半角の数字 2 桁（多くは 01）。空なら 01 にします。",
                    "pattern": "[0-9]{2}",
                    "max": 2
                },
                "sagawa_customer_code": {
                    "type": "text",
                    "label": "佐川急便のお客様コード",
                    "help": "e飛伝のお客様コード（半角の数字）。空なら e飛伝の既定になります。",
                    "pattern": "[0-9]{1,12}",
                    "max": 12
                }
            }
        }
    }
}
