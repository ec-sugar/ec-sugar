<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         failOnRisky="true"
>
    <!-- Risky（テストは走ったが走り方が信用できない）は落とす。
         ハンドラの積み残し・assert が 1 つも無い・出力した等が黙って溜まると、
         「Risky が出た」が何の合図にもならなくなる（264 件まで溜めた。原因は AppContractTest の後片付け）。
         0 を保てば、次に出たときに「今の変更がテストの独立性を壊した」と分かる -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- 手元の PHP の既定（Homebrew は 128M）だと、全部を 1 つのプロセスで流したときに写真のテストで上限を越える。CI と本番のイメージ（256M）より広く取る -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- テストも本番と同じ PostgreSQL で回す（テナント DB の作成・削除まで本物で検証するため） -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="54329"/>
        <env name="DB_DATABASE" value="ec_test"/>
        <env name="DB_USERNAME" value="ec_app"/>
        <env name="DB_PASSWORD" value="ec_dev_only"/>
        <env name="DB_URL" value=""/>
        <env name="TENANT_DB_PREFIX" value="ec_test_t_"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="63799"/>
        <!-- 写真の置き場は開発（storage/app/media）と分ける。店の ID が重なっても、テストの後片付けで開発の写真を消さない。
             別の名前のテスト用 DB で走らせる時は MEDIA_DIRECTORY=media-testing-<文字> も渡す（置き場の札が DB の名前の形を見るため。開発の置き場は MediaRoot が断る） -->
        <env name="MEDIA_DIRECTORY" value="media-testing"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <!-- 手元の .env に「Stripe と接続する」を試す鍵があっても、テストには持ち込まない（使う場面は config で入れる）。
             force はシェルから渡した環境変数に負けるので、秘密の鍵と外へ出る設定は tests/Support/TestEnvironmentGuard の PINNED が
             アプリを作る前に上書きする（ここで force するものは PINNED にも同じ値で載せる。TestEntryGuardTest が見張る） -->
        <env name="STRIPE_PLATFORM_SECRET_KEY" value="" force="true"/>
        <env name="STRIPE_CONNECT_WEBHOOK_SECRET" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
