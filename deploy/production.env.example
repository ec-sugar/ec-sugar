# EC-SUGAR 本番とステージングの設定の見本（ADR 0029）。秘密はここに書かない
#
# サーバーでは 1 つのファイル（例 /srv/ec-sugar/env/.env.production。持ち主だけ読める 0600）にして、--env-file で渡す:
#   docker compose -f docker-compose.prod.yml --env-file /srv/ec-sugar/env/.env.production up -d
# このファイルは compose の中の ${…} の値にも、app・queue・scheduler の環境変数にも使われる（DB の管理者のパスワードだけはアプリに渡さない）
#
# 各項目の印（後で作るインストーラー deploy/install.sh が見る）:
#   【作る】インストーラーがサーバーで作る（乱数のパスワード・鍵）。人が考えない。リポジトリにも Mac にも置かない
#   【聞く】インストーラーが聞く（環境ごとに違う）
#   【既定】既定のまま。変えるときは理由を書く
# パスワードは英数字だけで作る（Redis の設定ファイルと URL に入れても壊れないように）

# ---------- compose が使うもの（EC_SUGAR_…） ----------
# 前の名前 SUGAR_EC_… で入れたサーバーは、ec-sugar とインストーラーが同じ値の EC_SUGAR_… の行を足す（前の名前の行は残し、両方に書く。
# 前の名前の行がある間は compose も道具もそちらを先に読む。ADR 0030 の「作って決めたこと」）。新しく入れるサーバーは新しい名前だけ

# 【作る】このファイル自身の道筋。app・queue・scheduler がここから環境変数を読む
EC_SUGAR_ENV_FILE=/srv/ec-sugar/env/.env.production
# 【作る】動かすイメージの名前と印（コミットの印。latest は使わない）。更新はこれを書き換えて差し替える（ADR 0006）
EC_SUGAR_IMAGE=ec-sugar:<コミットの印>
# 【聞く】受け口の住所。ステージングは VM の中なので 0.0.0.0（家の LAN の外はホストで落とす）、本番は決めた住所。
# Cloudflare Tunnel の形（答えの FRONT=tunnel）は 127.0.0.1（外からは cloudflared を通ってだけ届く。install.sh がほかの値を断る）
EC_SUGAR_BIND=0.0.0.0
# 【既定】受け口のポート（https と、https へ送るだけの http）
EC_SUGAR_HTTPS_PORT=443
EC_SUGAR_HTTP_PORT=80
# 【聞く】管理画面のホストと、ショップのホストの親（ショップは *.<親>）
EC_SUGAR_ADMIN_HOST=admin.example.jp
EC_SUGAR_SHOP_DOMAIN=example.jp
# 【聞く】店の数の形。single（既定。1 システム・1 店舗。ショップのホストは自分のドメインそのもの。上の EC_SUGAR_SHOP_DOMAIN もそのホスト）か
# multi（複数の店。店は <店>.<EC_SUGAR_SHOP_DOMAIN>）。install.sh が答えの SHOPS から書く
EC_SUGAR_SHOPS=single
# 【作る】ショップの場所の名前（入口の Caddy。single はショップのホスト、multi は *.<ショップのドメイン>）と、nginx が受ける名前（空白で区切る）
EC_SUGAR_SITE_SHOP=example.jp
EC_SUGAR_SERVER_NAMES="admin.example.jp example.jp"
# 【聞く】証明書の取り方（入口の Caddy。ADR 0031）。auto（既定。Let's Encrypt から自動で取る。店のホストは初めて来たときにその場で）、
# dns（外から届かないステージング。Cloudflare の DNS の API の鍵で *.ショップのドメインを取る）、manual（手で用意した証明書）。
# install.sh が答え（CLOUDFLARE_TOKEN_FILE・TLS_CERT・TLS_KEY）から決める
EC_SUGAR_TLS_MODE=auto
# 【作る】入口の秘密の置き場（DNS の API の鍵 cloudflare_token・手で用意した tls/cert.pem と tls/key.pem）。root だけの 0700 の置き場で、
# 中のファイルは入口の Caddy の利用者（uid 65532）だけが読める 0400（インストーラーが写す）。使わない取り方でも置き場は要る（空でよい）
EC_SUGAR_CADDY_SECRETS=/srv/ec-sugar/secrets/caddy
# 【作る】Cloudflare Tunnel の形（FRONT=tunnel。ADR 0052）だけ: cloudflared のトークン（token）と行き先（config.yml）の置き場。
# root の持ち物・cloudflared の利用者（uid 65533）のグループ 0750、中は 0440（インストーラーが写して書く）。compose が読み取り専用で /etc/cloudflared に差し込む。
# ほかの形では書かない（docker-compose.tunnel.yml を重ねないので使わない）
# EC_SUGAR_TUNNEL_DIR=/srv/ec-sugar/secrets/tunnel
# 【既定】Cloudflare Tunnel の形の、Caddy と cloudflared だけの内側の網の範囲・自動で配る範囲（後ろ半分）・gateway・cloudflared の住所（Caddy が CF-Connecting-IP を
# 信じる相手）。既定は docker-compose.tunnel.yml にある。ほかの網と重なるときだけ 4 つをそろえて書く（住所は範囲の中で、自動で配る範囲の外）:
# EC_SUGAR_TUNNEL_SUBNET=172.30.255.240/29
# EC_SUGAR_TUNNEL_RANGE=172.30.255.244/30
# EC_SUGAR_TUNNEL_GATEWAY=172.30.255.241
# EC_SUGAR_TUNNEL_ADDR=172.30.255.242
# 【既定】入口の前の網（Caddy と nginx）の範囲・自動で配る範囲（後ろ半分）・Caddy の住所（前半の固定）。nginx は接続元の見出しをこの住所からだけ信じる。
# 既定は compose に書いてある（ここに書くと、後で既定を直しても伝わらないので書かない）。
# サーバーのほかの網と重なって起動できないときだけ、3 つをそろえて書く（Caddy の住所は範囲の中で、自動で配る範囲の外）:
# EC_SUGAR_FRONT_SUBNET=172.30.255.224/28
# EC_SUGAR_FRONT_RANGE=172.30.255.232/29
# EC_SUGAR_CADDY_ADDR=172.30.255.226
# 【既定】外への通信（ADR 0102。docs/install.md の「外への通信」）。アプリから外への https は出口の代理（egress）を通る。形は
#   watch（既定）: 許す一覧（docker/egress/allow.txt）に無い宛先も通し、名前と数を記録する（運営の様子に出る）
#   enforce: 許す一覧に無い宛先を断り、アプリから外へ直に出る道も外す（メールは MAIL_HOST:MAIL_PORT へだけ中継。MAIL_HOST は名前にする）
#   off: アプリが代理を使わない（代理が困ったときの逃げ道）
# 替えるときは手で書かずに sudo ec-sugar egress <形>（作り直しまでする）。一覧に足す名前は EC_SUGAR_EGRESS_ALLOW（カンマか空白で区切る。*.example.com の形も）:
# EC_SUGAR_EGRESS_MODE=watch
# EC_SUGAR_EGRESS_ALLOW=
# 【既定】コンテナからホストへ届いてよい TCP のポート（ホストの防火壁 ec-sugar firewall。既定は空 = どこへも届かない）。
# MAIL_HOST をこのサーバーの Postfix に向けるときだけ、そのポートを書く（例 25,587）。書いたら sudo ec-sugar firewall:
# EC_SUGAR_HOST_ALLOW_PORTS=
# 【既定】アプリと代理だけの網の範囲・自動で配る範囲（後ろ半分）・gateway・代理の住所。ほかの網と重なるときだけ 4 つをそろえて書く:
# EC_SUGAR_EGRESS_SUBNET=172.30.255.192/28
# EC_SUGAR_EGRESS_RANGE=172.30.255.200/29
# EC_SUGAR_EGRESS_GATEWAY=172.30.255.193
# EC_SUGAR_EGRESS_ADDR=172.30.255.194
# 【聞く】HSTS（https だけで来るようにブラウザに覚えさせる）の秒数。ステージングは 300（5 分）、本番は 31536000（1 年）
EC_SUGAR_HSTS_MAX_AGE=300
# 【既定】ステージングで届いたメールを見る画面のポート（VM の中の 127.0.0.1 だけ。--profile staging のとき）
EC_SUGAR_MAIL_UI_PORT=8025
# 【作る】ステージングの Mailpit の画面の Basic 認証のハッシュ（ui.htpasswd）の保存先。Mailpit の利用者（uid 1000）だけが入れる 0700。
# パスワードの平文は root だけが読む /srv/ec-sugar/secrets/mailpit-ui-password（インストーラーが乱数で 1 回だけ作る）
EC_SUGAR_MAILPIT_SECRETS=/srv/ec-sugar/secrets/mailpit
# 【作る】DB の管理者（superuser の ec）のパスワード。DB を初めて作るときに使う。アプリには渡らない
EC_SUGAR_DB_SUPERUSER_PASSWORD=

# ---------- アプリ（Laravel） ----------
# APP_ENV=production と APP_DEBUG=false は compose が決め打ちする（ここに書いても変わらない。ステージングも production で動かす）
APP_ENV=production
APP_DEBUG=false

# 【既定】
APP_NAME=EC-SUGAR
# 【作る】php artisan key:generate --show の値。店の個人情報の暗号の鍵の元。失くすと戻せないのでバックアップを別に保管する
APP_KEY=
# 【聞く】管理画面の URL と同じでよい
APP_URL=https://admin.example.jp
# 【既定】
APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# 【既定】記録は標準エラーへ（docker の記録に入る。compose が 1 コンテナ 50MB で回す）
LOG_CHANNEL=stderr
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# 【既定】中央 DB。アプリは superuser でないロール ec_app で入る（ADR 0003）
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ec_central
DB_USERNAME=ec_app
# 【作る】アプリのロール ec_app のパスワード（DB を初めて作るときにこのパスワードでロールが作られる）
DB_PASSWORD=
# 【既定】店ごとの DB の名前の前置き
TENANT_DB_PREFIX=ec_t_
TENANT_DB_SUFFIX=

# 【聞く】中央のホスト（Stripe の通知を受ける。管理画面のホストも自動で入る）。カンマ区切り
CENTRAL_DOMAINS=api.example.jp
# 【聞く】管理画面のホストと URL（上の EC_SUGAR_ADMIN_HOST と同じ名前。パスキーはこのオリジンでしか使えない）
ADMIN_DOMAIN=admin.example.jp
ADMIN_URL=https://admin.example.jp
# 【聞く】管理画面に入れる接続元（カンマ区切りの IP / CIDR）。空なら本番では全部断る。ステージングは見る端末のいる LAN の範囲（例 192.168.0.0/24）
ADMIN_ALLOWED_IPS=192.168.0.0/24
# 【既定】信じる前段の代理（X-Forwarded-For を伝えてくる相手）。空のまま。入口の Caddy が付けた接続元は nginx が Caddy の住所からだけ受けて
# REMOTE_ADDR に直し、PHP へは代理の見出しを渡さない（nginx から PHP は FastCGI の直結で代理ではない）。* や 0.0.0.0/0 は読み捨てる
TRUSTED_PROXIES=

# 【既定】セッションは Redis に暗号化して置く。Cookie は https だけで送る
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# 【既定】
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# 【既定】Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# 【作る】Redis のパスワード（英数字）
REDIS_PASSWORD=
# キューは店の接頭辞の付かない専用の接続 queue（config/database.php）を使う。REDIS_QUEUE_CONNECTION を default や cache にしない（すると起動で止まる）

# 【聞く】メールの送信サービス。ステージングは Mailpit（--profile staging）で外へ出さない: MAIL_HOST=mailpit・MAIL_PORT=1025・認証なし。
# 本番は外部の送信サービス（SMTP）のホストと、そのパスワード（【聞く】。ここには書かない）
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.jp"
MAIL_FROM_NAME="${APP_NAME}"

# 【既定】商品とショップの写真の置き場（storage/app/<名前>。名前つきの置き場 ec-sugar_storage の中）
MEDIA_DIRECTORY=media
# 【既定】写真の置き場の上限（config/media.php）: 店ごとの合計（MB）・店ごとに 1 日に増やせる量（MB）・店ごとに 1 分に上げられる写真の数。
# 数えるのは作り直して置いた写真（大と中の WebP）。超えたら上げるのを断り、9 割を超えたら運営の様子に出す（上限に届いたらメールも）
MEDIA_SHOP_QUOTA_MB=2048
MEDIA_DAILY_UPLOAD_MB=500
MEDIA_UPLOADS_PER_MINUTE=30

# 【聞く】本番の Stripe の鍵（sk_live_）を置けるか。ステージングは必ず false（テストの鍵だけ。ADR 0029）、本番は true。
# 空にすると APP_ENV=production なので「置ける」に倒れる。ステージングで書き忘れないこと
PAYMENT_LIVE_KEYS_ALLOWED=false

# 【聞く】「Stripe とつなぐ」（SaaS 版、ADR 0022）の運営の秘密鍵と通知の署名の鍵。ここには書かない。
# パッケージ版とステージングの最初は空のまま（店が管理画面で自分のテストの鍵を貼る）
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
