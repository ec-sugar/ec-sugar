def check_url(value, allow_http, where):
    if not value or re.search(r"[\s\x00-\x1f\x7f\"'\\<>`]", value):
        raise ConfigError(where + " の URL の形が違います")
    parts = urlsplit(value)
    schemes = ("https", "http") if allow_http else ("https",)
    if parts.scheme not in schemes:
        raise ConfigError(where + " は https の URL にします（http はテストの ALLOW_HTTP=yes の時だけ）")
    if not parts.hostname or "@" in parts.netloc:
        raise ConfigError(where + " の URL にホストが無いか、名前とパスワードが入っています")
    if parts.fragment:
        raise ConfigError(where + " の URL に # は書けません")
    return value


def load_config(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            lines = f.read().splitlines()
    except (OSError, UnicodeDecodeError):
        raise ConfigError("設定のファイルを読めません")
    base = os.path.dirname(os.path.abspath(path))
    cfg = {"PAGE": [], "LINKS_PAGE": []}
    for no, line in enumerate(lines, 1):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise ConfigError("設定の {} 行目が key=value の形ではありません".format(no))
        key, value = line.split("=", 1)
        key = key.strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'" and key not in ("NOTIFY_COMMAND", "USER_AGENT"):
            value = value[1:-1]
        if key not in CONFIG_KEYS:
            raise ConfigError("設定の {} 行目: 知らない名前 {}".format(no, clean(key, 40)))
        if key in ("PAGE", "LINKS_PAGE"):
            cfg[key].append(value)
        elif key in cfg:
            raise ConfigError("設定の {} 行目: {} が 2 回あります".format(no, key))
        else:
            cfg[key] = value

    allow_http = cfg.get("ALLOW_HTTP", "") == "yes"
    if cfg.get("ALLOW_HTTP", "") not in ("", "yes", "no"):
        raise ConfigError("ALLOW_HTTP は yes か no です")
    for key in ("STATUS_URL", "PUBLIC_KEY", "STATE_DIR"):
        if not cfg.get(key):
            raise ConfigError(key + " がありません")
    status_url = check_url(cfg["STATUS_URL"], allow_http, "STATUS_URL")
    if urlsplit(status_url).query:
        raise ConfigError("STATUS_URL に ? は書けません")
    pages = []
    links = set()
    for key in ("PAGE", "LINKS_PAGE"):
        for i, page in enumerate(cfg[key], 1):
            check_url(page, allow_http, "{}（{} 行目）".format(key, i))
            if page in pages and (key == "PAGE" or page in links):
                raise ConfigError("{} に同じ URL が 2 回あります".format(key))
            if page not in pages:
                pages.append(page)
            if key == "LINKS_PAGE":
                links.add(page)
    if len(pages) > MAX_PAGES:
        raise ConfigError("PAGE と LINKS_PAGE は合わせて {} までです".format(MAX_PAGES))
    if not cfg.get("WEBHOOK_FILE") and not cfg.get("NOTIFY_COMMAND"):
        raise ConfigError("通知先（WEBHOOK_FILE か NOTIFY_COMMAND）がありません")
    limit = cfg.get("TIME_LIMIT", str(DEFAULT_TIME_LIMIT))
    if not limit.isdigit() or not 1 <= int(limit) <= 3600:
        raise ConfigError("TIME_LIMIT は 1〜3600 の秒です")
    agent = cfg.get("USER_AGENT", DEFAULT_USER_AGENT)
    if not re.match(r"\A[\x20-\x7e]{1,300}\Z", agent):
        raise ConfigError("USER_AGENT は 300 字までの英数字と記号です")

    def resolve(p):
        return p if os.path.isabs(p) else os.path.join(base, p)

    name = cfg.get("NAME") or urlsplit(status_url).hostname
    return {
        "status_url": status_url,
        "public_key": resolve(cfg["PUBLIC_KEY"]),
        "pages": pages,
        "links_pages": links,
        "webhook_file": resolve(cfg["WEBHOOK_FILE"]) if cfg.get("WEBHOOK_FILE") else None,
        "token_file": resolve(cfg["SENTINEL_TOKEN_FILE"]) if cfg.get("SENTINEL_TOKEN_FILE") else None,
        "notify_command": cfg.get("NOTIFY_COMMAND") or None,
        "state_dir": resolve(cfg["STATE_DIR"]),
        "name": clean(name, 80),
        "allow_http": allow_http,
        "time_limit": int(limit),
        "user_agent": agent,
    }


def read_private_file(path, what):
    """本人だけが読める 0600 のふつうのファイルの中身（リンクは断る。中身は出さない）"""
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    except OSError:
        raise ConfigError(what + " を読めません（リンクは不可）")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o077:
            raise ConfigError(what + " は自分だけが読める 0600 のファイルにします")
        raw = os.read(fd, 4096)
    finally:
        os.close(fd)
    return raw.decode("utf-8", "replace").strip()


def read_webhook(cfg):
    url = read_private_file(cfg["webhook_file"], "WEBHOOK_FILE")
    try:
        check_url(url, cfg["allow_http"], "WEBHOOK_FILE")
    except ConfigError:
        # URL の中身は出さない
        raise ConfigError("WEBHOOK_FILE の中身が https の URL ではありません")
    return url


def read_token(cfg):
    if not cfg["token_file"]:
        return None
    token = read_private_file(cfg["token_file"], "SENTINEL_TOKEN_FILE")
    if not TOKEN.match(token):
        raise ConfigError("SENTINEL_TOKEN_FILE の中身が 32 桁の 16 進ではありません（`sudo ec-sugar integrity token` が出すもの）")
    return token


# ---------- 道具 ----------

OPENSSL = os.environ.get("EC_SENTINEL_OPENSSL", "")
CURL = os.environ.get("EC_SENTINEL_CURL", "")
DEADLINE = [None]   # 1 回の確認の締め切り（time.monotonic の値）


def remaining_seconds():
    if DEADLINE[0] is None:
        return FETCH_SECONDS
    left = DEADLINE[0] - time.monotonic()
    if left < 1:
        raise TimeLimit()
    return max(1, min(FETCH_SECONDS, int(left)))


def curl_base(cfg, seconds):
    proto = "=http,https" if cfg["allow_http"] else "=https"
    # -q は ~/.curlrc を読まないため、いちばん前に置く
    return [CURL, "-q", "-sS", "--proto", proto, "--proto-redir", proto, "--max-redirs", "0",
            "--connect-timeout", str(min(10, seconds)), "-m", str(seconds), "-A", cfg["user_agent"]]


def fetch(url, limit, cfg, tmp, secret_config=None):
    """GET して (番号, 見出しの辞書〔小文字の名前 → 値の並び〕, 中身) を返す。転送は追わない。上限を超えたら FetchError、締め切りを過ぎたら TimeLimit。
    secret_config は curl の設定の行（トークンのヘッダー）で、引数でなく標準入力で渡す"""
    seconds = remaining_seconds()
    hdr_path = os.path.join(tmp, "headers")
    if os.path.exists(hdr_path):
        os.unlink(hdr_path)
    args = curl_base(cfg, seconds) + ["--max-filesize", str(limit), "-D", hdr_path, "-o", "-"]
    if secret_config:
        args += ["-K", "-"]
    args += ["--", url]
    proc = subprocess.Popen(args, stdin=subprocess.PIPE if secret_config else subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    if secret_config:
        proc.stdin.write(secret_config.encode("ascii"))
        proc.stdin.close()
    # 長さを名乗らずに流し続ける答えも、上限 + 1 バイトで読むのをやめる
    body = proc.stdout.read(limit + 1)
    if len(body) > limit:
        proc.kill()
        proc.wait()
        raise FetchError("応答が大きすぎます（上限 {} KB）".format(limit // 1024))
    proc.stdout.close()
    code = proc.wait()
    if code == 63:
        raise FetchError("応答が大きすぎます（上限 {} KB）".format(limit // 1024))
    if code == 28:
        # 締め切りで短くした取得の時間切れは、1 回の時間の上限を越えたもの
        if seconds < FETCH_SECONDS and DEADLINE[0] is not None:
            raise TimeLimit()
        raise FetchError("時間切れ")
    if code != 0:
        raise FetchError("接続できません（curl {}）".format(code))
    try:
        with open(hdr_path, "rb") as f:
            raw = f.read(256 * 1024).decode("latin-1")
    except OSError:
        raise FetchError("見出しを読めません")
    blocks = [b for b in re.split(r"\r?\n\r?\n", raw) if b.strip()]
    if not blocks:
        raise FetchError("見出しがありません")
    lines = blocks[-1].splitlines()
    m = re.match(r"HTTP/[\d.]+ (\d{3})", lines[0])
    if not m:
        raise FetchError("応答の形が違います")
    headers = {}
    for line in lines[1:]:
        if ":" in line:
            k, v = line.split(":", 1)
            headers.setdefault(k.strip().lower(), []).append(v.strip())
    return int(m.group(1)), headers, body


def check_public_key(path):
    try:
        proc = subprocess.run([OPENSSL, "pkey", "-pubin", "-in", path, "-outform", "DER"],
                              stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        raise ConfigError("公開鍵を読めません（PUBLIC_KEY）")
    der = proc.stdout
    if proc.returncode != 0 or len(der) != 44 or not der.startswith(ED25519_SPKI_PREFIX):
        raise ConfigError("PUBLIC_KEY が Ed25519 の公開鍵の PEM ではありません")


def verify(public_key, data, sig_b64, tmp):
    try:
        sig = base64.b64decode(re.sub(rb"\s", b"", sig_b64), validate=True)
    except ValueError:
        return False
    if len(sig) != 64:
        return False
    data_path = os.path.join(tmp, "integrity.json")
    sig_path = os.path.join(tmp, "integrity.sig")
    with open(data_path, "wb") as f:
        f.write(data)
    with open(sig_path, "wb") as f:
        f.write(sig)
    proc = subprocess.run([OPENSSL, "pkeyutl", "-verify", "-pubin", "-inkey", public_key, "-rawin",
                           "-in", data_path, "-sigfile", sig_path],
                          stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=30)
    return proc.returncode == 0 and b"Signature Verified Successfully" in proc.stdout


def parse_checked_at(value):
    m = CHECKED_AT.match(value) if isinstance(value, str) else None
    if not m:
        return None
    try:
        y, mo, d, h, mi, s = (int(x) for x in m.groups())
        return calendar.timegm((y, mo, d, h, mi, s, 0, 0, 0)) if 1 <= mo <= 12 and 1 <= d <= 31 and h < 24 and mi < 60 and s < 60 else None
    except (ValueError, OverflowError):
        return None


def is_int(v):
    return isinstance(v, int) and not isinstance(v, bool)


# ---------- 様子 ----------

def read_status(cfg, tmp):
    """状態を取って確認する。('fetch', 理由) / ('signature', None) / ('format', 理由) / ('ok', 解いた中身)"""
    sig_url = cfg["status_url"] + ".sig"
    token = read_token(cfg)
    # 合い言葉は様子の 2 つの取得にだけ付ける（ページには付けない。ふつうの客と見分けさせない）
    secret = 'header = "{}: {}"\n'.format(TOKEN_HEADER, token) if token else None
    for attempt in (1, 2):
        try:
            code, _, data = fetch(cfg["status_url"], STATUS_MAX, cfg, tmp, secret)
            if code != 200:
                raise FetchError("HTTP {}".format(code))
            code, _, sig = fetch(sig_url, SIG_MAX, cfg, tmp, secret)
            if code != 200:
                raise FetchError("署名が HTTP {}".format(code))
        except FetchError as e:
            return "fetch", str(e)
        except TimeLimit:
            return "fetch", "1 回の時間の上限（{} 秒）を越えました".format(cfg["time_limit"])
        if verify(cfg["public_key"], data, sig, tmp):
            break
        if attempt == 1:
            time.sleep(SIG_RETRY_WAIT)
    else:
        return "signature", None
    try:
        doc = json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return "format", "JSON として読めません"
    if not isinstance(doc, dict):
        return "format", "JSON の形が違います"
    if not is_int(doc.get("format")) or doc.get("format") != 1:
        return "format", "format が 1 ではありません"
    if not isinstance(doc.get("server"), str) or not SERVER_ID.match(doc["server"]):
        return "format", "server の形が違います"
    if not is_int(doc.get("generation")) or doc["generation"] < 0:
        return "format", "generation の形が違います"
    checked = parse_checked_at(doc.get("checked_at"))
    if checked is None:
        return "format", "checked_at の形が違います"
    if not isinstance(doc.get("ok"), bool):
        return "format", "ok の形が違います"
    if not isinstance(doc.get("problems"), list):
        return "format", "problems の形が違います"
    if "busy" in doc and not isinstance(doc["busy"], bool):
        return "format", "busy の形が違います"
    # problems は困りごとの種類（image・service・container・config・code・file・docker・expected・lock など）。
    # 知らない種類も形が合えば並べる
    problems = []
    for p in doc["problems"]:
        name = PROBLEM_NAME.sub("", p if isinstance(p, str) else "")[:64] or "（名前の無い問題）"
        if name not in problems:
            problems.append(name)
    return "ok", {
        "server": doc["server"],
        "generation": doc["generation"],
        "checked_at": checked,
        "ok": doc["ok"],
        "problems": sorted(problems),
        "busy": doc.get("busy") is True,
    }


# ---------- 店頭の指紋 ----------

def origin_of(url):
    p = urlsplit(url)
    try:
        port = p.port
    except ValueError:
        port = None
    default = {"https": 443, "http": 80}.get(p.scheme)
    host = (p.hostname or "").lower()
    return "{}://{}{}".format(p.scheme, host, "" if port in (None, default) else ":{}".format(port))


def normalize_path(path):
    return "/".join("{id}" if ID_SEGMENT.match(seg) else seg for seg in path.split("/"))


def show_url(page_url, value, keep_query=True, ids=False, origin_only=False):
    """属性の URL を、ページの URL から解いて見せる形に。同じ出どころはパスだけ、外は出どころか全部"""
    value = (value or "").strip()
    if value == "":
        return "（このページ）"
    if value.lower().startswith(("data:", "blob:")):
        return value[:5].lower() + "…sha256=" + hashlib.sha256(value.encode("utf-8", "replace")).hexdigest()[:16]
    try:
        absolute = urljoin(page_url, value)
        p = urlsplit(absolute)
    except ValueError:
        return "（読めない URL）sha256=" + hashlib.sha256(value.encode("utf-8", "replace")).hexdigest()[:16]
    if origin_of(absolute) == origin_of(page_url):
        path = normalize_path(p.path) if ids else p.path
        return clean((path or "/") + ("?" + p.query if keep_query and p.query else ""), 300)
    if origin_only:
        return clean(origin_of(absolute), 300)
    return clean(absolute.split("#", 1)[0], 300)


def normalize_csp(value):
    # 要求ごとに変わる nonce はそろえる（店頭の CSP には今は無いが、印刷の画面などにある形）
    value = re.sub(r"'nonce-[^']*'", "'nonce-*'", value)
    directives = [re.sub(r"\s+", " ", d).strip() for d in value.split(";")]
    return "; ".join(d for d in directives if d)


def charset_of(value):
    m = re.search(r"charset\s*=\s*[\"']?([^\s;\"']+)", value or "", re.I)
    return m.group(1).lower() if m else None


class Collector(HTMLParser):
    """指紋に入れる要素を集める。HTMLParser として HTML を解く時と、raw_scan から生の HTML の要素を渡される時の両方で使う"""

    def __init__(self, page_url, links=False):
        super().__init__(convert_charrefs=True)
        self.page_url = page_url
        self.links = links
        self.entries = []
        self.scripts = []        # 中身を取りに行く同じ出どころのスクリプト（指紋の行の番号, URL）
        self.link_origins = []
        self.charsets = []       # meta が名乗った文字コード
        self.inline = None
        self.buf = []

    def add(self, kind, ident="", value=""):
        self.entries.append([kind, ident, value])

    def script_src(self, raw, how=""):
        absolute = None
        try:
            absolute = urljoin(self.page_url, raw.strip())
        except ValueError:
            pass
        shown = show_url(self.page_url, raw) + how
        same = absolute is not None and not raw.strip().lower().startswith(("data:", "blob:")) and origin_of(absolute) == origin_of(self.page_url)
        self.add("script", shown, "")
        if same:
            self.scripts.append((len(self.entries) - 1, absolute.split("#", 1)[0]))

    def handle_starttag(self, tag, attrs):
        a = {}
        for k, v in attrs:
            if k not in a:
                a[k] = v if v is not None else ""
        for k, v in a.items():
            if k.startswith("on"):
                self.add("handler", clean(k, 40))
            elif k in ("href", "src", "action", "formaction", "data", "xlink:href") and re.match(r"[\s\x00-\x20]*j\s*a\s*v\s*a\s*s\s*c\s*r\s*i\s*p\s*t\s*:", v, re.I):
                self.add("javascript-url", clean(tag + "." + k, 40))
        if tag == "script":
            src = a.get("src") or a.get("href") or a.get("xlink:href")
            if src:
                self.script_src(src)
                trusted = a.get("data-sugar-script-src")
                if trusted is not None:
                    # 核の Trusted Types の関所に渡す、外の宛先の一覧（ADR 0034）
                    self.add("script", self.entries[-1][1] + " の Trusted Types の宛先", clean(trusted, 300))
                self.inline = None
            else:
                self.inline = (a.get("type") or "").strip().lower() or "（type なし）"
                self.buf = []
        elif tag == "link":
            rel = (a.get("rel") or "").lower().split()
            if a.get("href") and ("modulepreload" in rel or ("preload" in rel and (a.get("as") or "").lower() == "script")):
                self.script_src(a["href"], "（" + ("modulepreload" if "modulepreload" in rel else "preload") + "）")
        elif tag == "form":
            method = (a.get("method") or "get").strip().lower()
            self.add("form", "", method + " " + show_url(self.page_url, a.get("action"), keep_query=False, ids=True))
        elif tag in ("button", "input") and "formaction" in a:
            self.add("form", "", "formaction " + show_url(self.page_url, a.get("formaction"), keep_query=False, ids=True))
        elif tag in ("iframe", "frame"):
            if "srcdoc" in a:
                self.add("iframe", "", "srcdoc sha256=" + hashlib.sha256(a["srcdoc"].encode("utf-8", "replace")).hexdigest()[:16])
            else:
                # 宛先は出どころだけ（動画や地図の ID は店の人が直す値）。sandbox は守りの値なので入れる
                sandbox = " sandbox=" + clean(" ".join(sorted(a["sandbox"].split())), 200) if "sandbox" in a else ""
                self.add("iframe", "", show_url(self.page_url, a.get("src"), origin_only=True) + sandbox)
        elif tag in ("object", "embed"):
            self.add("object", "", show_url(self.page_url, a.get("data") or a.get("src"), origin_only=True))
        elif tag == "meta":
            if "charset" in a:
                self.charsets.append(a["charset"].strip().lower())
            if "http-equiv" in a:
                name = a["http-equiv"].strip().lower()
                content = a.get("content", "")
                if name == "content-security-policy":
                    content = normalize_csp(content)
                if name == "content-type" and charset_of(content):
                    self.charsets.append(charset_of(content))
                self.add("meta", clean(name, 60), clean(content, 300))
        elif tag == "base":
            self.add("base", "", show_url(self.page_url, a.get("href")))
        elif tag in ("a", "area") and self.links and a.get("href"):
            # 外の出どころへのリンクの出どころだけ（道筋は店の人が直す値）。カートなどで「支払いはこちら」と偽の外へ誘うのに気づく
            try:
                absolute = urljoin(self.page_url, a["href"].strip())
            except ValueError:
                absolute = ""
            if urlsplit(absolute).scheme in ("http", "https") and origin_of(absolute) != origin_of(self.page_url):
                origin = clean(origin_of(absolute), 300)
                if origin not in self.link_origins and len(self.link_origins) < MAX_LINK_ORIGINS:
                    self.link_origins.append(origin)

    def handle_data(self, data):
        if self.inline is not None:
            self.buf.append(data)

    def handle_endtag(self, tag):
        if tag == "script" and self.inline is not None:
            kind = self.inline
            body = "".join(self.buf)
            if kind in DATA_ONLY_TYPES:
                self.add("inline", kind, "")
            else:
                self.add("inline", clean(kind, 60), "sha256=" + hashlib.sha256(body.encode("utf-8", "surrogatepass")).hexdigest()[:32])
            self.inline = None
            self.buf = []

    def finish(self):
        for origin in self.link_origins:
            self.add("link", "", origin)


def raw_scan(text, collector):
    """生の HTML の中の、< で始まる要素の開始の札を全部拾う（注釈・CDATA・スクリプトの中も）。
    HTMLParser とブラウザで注釈の終わりの解き方が違い（<!--> や --!> など）、HTMLParser に見えない要素がブラウザでは生きることがあるため。
    店頭の HTML には注釈もインラインの JavaScript も無い（JSON-LD は < を \\u003C で書く）ので、ふつうは HTMLParser と同じものだけを拾う"""
    lower = text.lower()
    n = len(text)
    pos = 0
    while True:
        m = TAG_START.search(text, pos)
        if not m:
            break
        name = m.group(1).lower()
        i = m.end()
        attrs = []
        while i < n:
            while i < n and text[i] in WS + "/":
                i += 1
            if i >= n or text[i] == ">":
                break
            am = ATTR_NAME.match(text, i)
            key = am.group(0).lower()
            i = am.end()
            while i < n and text[i] in WS:
                i += 1
            value = None
            if i < n and text[i] == "=":
                i += 1
                while i < n and text[i] in WS:
                    i += 1
                if i < n and text[i] in "\"'":
                    j = text.find(text[i], i + 1)
                    j = n if j < 0 else j
                    value = text[i + 1:j]
                    i = j + 1
                else:
                    vm = UNQUOTED.match(text, i)
                    value = vm.group(0)
                    i = vm.end()
            attrs.append((key, html.unescape(value) if value is not None else None))
        end = min(i + 1, n)
        collector.handle_starttag(name, attrs)
        if name == "script" and collector.inline is not None:
            close = lower.find("</script", end)
            collector.handle_data(text[end:close if close >= 0 else n])
            collector.handle_endtag("script")
        # 中身（スクリプトの中も）を飛ばさずに、次の < から続ける
        pos = max(end, m.start() + 1)
    collector.finish()


def comment_spans(text):
    """注釈（<!-- から次の --> まで）と CDATA（<![CDATA[ から ]]> まで）の中身を、古い読み方（いちばん長く取る）でつないで返す。
    <!--> や --!> のように解き方の割れる形でも、次の --> までを 1 つの注釈とみなす（Python 3.14 までの HTMLParser と同じ）。
    HTMLParser の読み方は版で変わる（3.15 はブラウザに寄せた）ので、隠れた要素の判定をそれに頼らず、この範囲の要素も隠れた要素にする。
    店頭の HTML には注釈も CDATA も無いので、ふだんは空"""
    parts = []
    pos = 0
    n = len(text)
    while pos < n:
        c = text.find("<!--", pos)
        d = text.find("<![CDATA[", pos)
        if c < 0 and d < 0:
            break
        if d < 0 or 0 <= c < d:
            start, body, closer = c, c + 4, "-->"
        else:
            start, body, closer = d, d + 9, "]]>"
        end = text.find(closer, body)
        end = n if end < 0 else end
        parts.append(text[body:end])
        pos = max(end + len(closer), start + 1)
    return "\n".join(parts)


def fingerprint(page_url, cfg, tmp):
    """1 ページの指紋。{"entries": [種類, 名前, 値] の並び, "hidden": 隠れた要素の行, "charset": UTF-8 でない理由}。開けなければ FetchError"""
    code, headers, body = fetch(page_url, PAGE_MAX, cfg, tmp)
    entries = []
    result = {"entries": entries, "hidden": [], "charset": None}
    for name in FINGERPRINT_HEADERS:
        for value in headers.get(name, []):
            entries.append(["header", name, clean(value.lower() if name == "content-type" else value, 300)])
    if 300 <= code < 400:
        entries.append(["status", "", str(code)])
        entries.append(["redirect", "", show_url(page_url, (headers.get("location") or [""])[0])])
        entries.sort()
        return result
    if not 200 <= code < 300:
        raise FetchError("HTTP {}".format(code))
    entries.append(["status", "", str(code)])
    for value in headers.get("content-security-policy", []):
        entries.append(["csp", "", normalize_csp(value)])
    for value in headers.get("content-security-policy-report-only", []):
        entries.append(["csp-report-only", "", normalize_csp(value)])

    # 文字コード: UTF-8 のほかで解かせると、指紋を取った HTML とブラウザの解く HTML が変わる
    reasons = []
    if body.startswith((b"\xff\xfe", b"\xfe\xff")):
        reasons.append("BOM が UTF-16")
    try:
        text = body.decode("utf-8")
    except UnicodeDecodeError:
        text = body.decode("utf-8", "replace")
        reasons.append("UTF-8 として読めない")
    if text.startswith("﻿"):
        text = text[1:]
    links = page_url in cfg["links_pages"]
    parsed = Collector(page_url, links)
    try:
        parsed.feed(text)
        parsed.close()
    except Exception:
        raise FetchError("HTML を読めません")
    parsed.finish()
    scanned = Collector(page_url, links)
    raw_scan(text, scanned)

    declared = [c for c in [charset_of(v) for v in headers.get("content-type", [])] + scanned.charsets if c]
    others = sorted(set(c for c in declared if c not in ("utf-8", "utf8")))
    if others:
        reasons.append("記載された文字コードが " + ", ".join(clean(c, 40) for c in others))
    elif not declared and not body.startswith(b"\xef\xbb\xbf"):
        reasons.append("文字コードを記載していない（Content-Type にも meta にも charset が無い）")
    result["charset"] = "・".join(reasons) or None

    # HTMLParser に見えず、生の HTML にある要素（注釈・CDATA などに隠したもの）。ブラウザでは生きることがある。
    # あわせて、注釈と CDATA の範囲（古い読み方）にある要素も隠れた要素にする。HTMLParser の読み方が版で変わっても、同じ結果になるように
    hidden = Counter(tuple(e) for e in scanned.entries) - Counter(tuple(e) for e in parsed.entries)
    spans = comment_spans(text)
    if spans:
        inside = Collector(page_url, links)
        raw_scan(spans, inside)
        hidden |= Counter(tuple(e) for e in inside.entries)
    result["hidden"] = sorted(render(list(e)) for e in hidden.elements())

    cache = {}
    for n, (index, url) in enumerate(scanned.scripts):
        if n >= MAX_SCRIPTS:
            scanned.entries[index][2] = "（数が多いので中身は見ていない）"
            continue
        if url not in cache:
            try:
                scode, _, sbody = fetch(url, SCRIPT_MAX, cfg, tmp)
            except FetchError as e:
                raise FetchError("スクリプト {} を取れません（{}）".format(scanned.entries[index][1], e))
            if scode != 200:
                raise FetchError("スクリプト {} を取れません（HTTP {}）".format(scanned.entries[index][1], scode))
            cache[url] = "sha256=" + hashlib.sha256(sbody).hexdigest()[:32]
        scanned.entries[index][2] = cache[url]
    entries.extend(scanned.entries)
    entries.sort()
    return result


def csp_diff(old, new):
    def parse(v):
        result = {}
        for d in v.split(";"):
            parts = d.split()
            if parts:
                result.setdefault(parts[0].lower(), set()).update(parts[1:])
        return result
    a, b = parse(old), parse(new)
    lines = []
    for name in sorted(set(a) | set(b)):
        if name not in a:
            lines.append("{} が足された（{}）".format(name, " ".join(sorted(b[name]))))
        elif name not in b:
            lines.append("{} が消えた".format(name))
        else:
            plus, minus = sorted(b[name] - a[name]), sorted(a[name] - b[name])
            if plus:
                lines.append("{} に足された: {}".format(name, " ".join(plus)))
            if minus:
                lines.append("{} から消えた: {}".format(name, " ".join(minus)))
    return "、".join(lines) or "並びが変わった"


def render(entry):
    kind, ident, value = entry
    label = KIND_LABELS.get(kind, kind)
    text = " ".join(x for x in (ident, value) if x)
    return clean("{} {}".format(label, text).strip(), 400)


def page_diff(baseline, current):
    """基準との違いを、足された・消えた・変わったの行で返す"""
    base_c = Counter(tuple(e) for e in baseline)
    cur_c = Counter(tuple(e) for e in current)
    added = list((cur_c - base_c).elements())
    removed = list((base_c - cur_c).elements())
    lines = []
    for key in sorted(set((e[0], e[1]) for e in added) & set((e[0], e[1]) for e in removed)):
        olds = [e for e in removed if (e[0], e[1]) == key]
        news = [e for e in added if (e[0], e[1]) == key]
        for o, n in zip(olds, news):
            removed.remove(o)
            added.remove(n)
            if o[0] in ("csp", "csp-report-only"):
                lines.append("変わった: {}（{}）".format(KIND_LABELS[o[0]], clean(csp_diff(o[2], n[2]), 400)))
            elif o[1] and o[0] == "script":
                lines.append("変わった: {} の中身（{} → {}）".format(render([o[0], o[1], ""]), o[2] or "なし", n[2] or "なし"))
            else:
                lines.append("変わった: {} → {}".format(render(o), clean(n[2] or n[1], 300)))
    lines += ["足された: " + render(e) for e in sorted(added)]
    lines += ["消えた: " + render(e) for e in sorted(removed)]
    return lines


