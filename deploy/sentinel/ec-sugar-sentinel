#!/usr/bin/env bash
# EC-SUGAR の外の見張り（ADR 0105 の 3）。EC-SUGAR を入れたサーバーとは**別の機械**（安い VPS・手元の Mac・家の別の PC）に置き、
# cron・systemd の timer・launchd で数分ごとに流す。使う道具は bash・curl・openssl 3・python3（標準のライブラリだけ）。
#
#   ec-sugar-sentinel check <設定>              様子（署名した integrity.json）と店頭の指紋を確かめ、困りごとと戻りを知らせる
#   ec-sugar-sentinel accept <設定> [--force]   今の店頭の指紋を基準として取る（入れた後・更新の後・App や埋め込みを足した後に。違いを並べて見せる）。
#                                               サーバーが困りごとを出している・busy・様子が古い・隠れた要素・UTF-8 でないページの時は断る（--force で越える）
#   ec-sugar-sentinel test-notify <設定>        テスト通知を送る
#
# 設定のファイル（key=value。# で始まる行と空の行は飛ばす。シェルとしては読まない）:
#   STATUS_URL=https://shop.example.jp/.well-known/ec-sugar/integrity.json   様子の URL（署名は同じ URL に .sig を足した所）
#   PUBLIC_KEY=/etc/ec-sugar-sentinel/integrity.pub     公開鍵の PEM（本番で `sudo ec-sugar integrity key` が出すもの）
#   SENTINEL_TOKEN_FILE=/etc/ec-sugar-sentinel/token    見張りの合い言葉（本番で `sudo ec-sugar integrity token` が出す 32 桁の 16 進）を書いた 0600 のファイル。
#                                                       様子の 2 つの取得にだけ見出し X-EC-Sugar-Sentinel で付ける（任意。無ければ中の「見張りが来ていない」が出ないだけ）
#   PAGE=https://shop.example.jp/                       指紋を取るページ（何行でも。PAGE と LINKS_PAGE で合わせて 20 まで）。トップ・商品など
#   LINKS_PAGE=https://shop.example.jp/cart             指紋を取り、外の出どころへのリンク（<a href>）の出どころも指紋に入れるページ（カートなど）
#   WEBHOOK_FILE=/etc/ec-sugar-sentinel/webhook         Slack 形式の Webhook の URL を 1 行で書いたファイル（本人だけが読める 0600）
#   NOTIFY_COMMAND=mail -s "$EC_SENTINEL_SUBJECT" you@example.jp   本文を標準入力で渡すコマンド（sh -c で流す）。WEBHOOK_FILE と両方でもよい
#   STATE_DIR=/var/lib/ec-sugar-sentinel                状態と基準を置くディレクトリ（無ければ 0700 で作る）
#   NAME=本番のショップ                                 知らせに出す名前（既定は STATUS_URL のホスト）
#   TIME_LIMIT=120                                      1 回の確かめの時間の上限（秒。越えたら困りごと）
#   USER_AGENT=…                                        取る時の User-Agent（既定はふつうのブラウザの形）
#   ALLOW_HTTP=yes                                      http を許す（テストだけ。ふだんは書かない＝https だけ）
#
# 知らせの決まり（同じ困りごとは続いている間 1 回だけ、戻ったら「戻りました」を 1 回）。様子の結果は、ページを見る前に送る:
#   すぐ知らせる: 署名が通らない・format が 1 でない（欠けた項目も）・server が基準と違う・ok が偽（problems の種類を並べる）・
#                 店頭の指紋が基準と違う・基準が無い・注釈などに隠れた要素がある・UTF-8 でない・1 回の確かめが時間の上限を越えた
#   2 回続いたら: 様子を取れない・checked_at が 5 分より古い・2 分より先・店頭のページを開けない
#   30 分続いたら: busy（更新などの途中）
#   15 分続いたら: 前の回が終わらない（錠が取れない）
#   1 回だけのお知らせ: generation が上がった（あるべき姿が変わった）・下がった
#
# 守り: 設定・Webhook の URL・合い言葉・コマンドを記録と知らせに出さない（URL と合い言葉は curl へ設定として標準入力で渡し、引数に載せない）。
# 取る時は https だけ・転送を追わない・時間と大きさに上限・圧縮を頼まない・~/.curlrc を読まない。HTML や JSON の中身はシェルに渡さない
# （解くのは python3 の中で、外のコマンドは引数の並びで呼ぶ）。知らせの文は制御文字を除いて長さを切る。
# 状態は STATE_DIR の中だけに書き、同時に 2 つ流れないよう錠を取る。
#
# 終わりの値: 0 困りごと無し・1 困りごとがある（知らせを送れなかった時も）・2 使い方か設定の誤り
set -u

usage() {
    cat << 'USAGE'
使い方: ec-sugar-sentinel check <設定>              状態とショップの指紋を確認して通知する
        ec-sugar-sentinel accept <設定> [--force]   今のショップの指紋を基準として取る（更新の後に）
        ec-sugar-sentinel test-notify <設定>        テスト通知を送る
設定の書き方はこのファイルの頭と docs/install.md の「外部監視を置く」
USAGE
}

# openssl 3 以上を探す（OPENSSL の環境変数 → PATH → Homebrew の openssl@3）。macOS の LibreSSL は Ed25519 の -rawin が無いので断る
find_openssl() {
    local c v
    for c in "${OPENSSL:-}" "$(command -v openssl 2> /dev/null)" /opt/homebrew/opt/openssl@3/bin/openssl /usr/local/opt/openssl@3/bin/openssl; do
        [ -n "$c" ] && [ -x "$c" ] || continue
        v="$("$c" version 2> /dev/null)"
        case "$v" in
            "OpenSSL "[3-9].*) printf '%s\n' "$c"; return 0 ;;
        esac
        if [ -n "${OPENSSL:-}" ] && [ "$c" = "$OPENSSL" ]; then
            echo "OPENSSL に指定したものが OpenSSL 3 以上ではありません（${v%% (*}）" >&2
            return 1
        fi
    done
    echo "OpenSSL 3 以上が見つかりません（LibreSSL は使えません）。macOS なら brew install openssl@3 か、OPENSSL=<パス> で指定する" >&2
    return 1
}

cmd="${1:-}"
conf="${2:-}"
force="${3:-}"
case "$cmd" in
    check | accept | test-notify) ;;
    -h | --help | help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
esac
if [ -z "$conf" ] || [ $# -gt 3 ] || { [ $# -eq 3 ] && { [ "$cmd" != accept ] || [ "$force" != --force ]; }; }; then
    usage >&2
    exit 2
fi
command -v python3 > /dev/null 2>&1 || { echo "python3 が見つかりません" >&2; exit 2; }
command -v curl > /dev/null 2>&1 || { echo "curl が見つかりません" >&2; exit 2; }
ossl="$(find_openssl)" || exit 2
EC_SENTINEL_OPENSSL="$ossl"
EC_SENTINEL_CURL="$(command -v curl)"
export EC_SENTINEL_OPENSSL EC_SENTINEL_CURL

