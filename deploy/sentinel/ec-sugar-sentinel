def open_state_dir(path):
    try:
        os.makedirs(path, mode=0o700, exist_ok=True)
        st = os.lstat(path)
    except OSError:
        raise ConfigError("STATE_DIR を作れません")
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ConfigError("STATE_DIR は自分の持ち物で、ほかの利用者が書けないディレクトリにします（リンクは不可）")


def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else default
    except (OSError, ValueError):
        return default


def save_json(path, data):
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=1, sort_keys=True)
            f.write("\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def take_lock(state_dir):
    fd = os.open(os.path.join(state_dir, "lock"), os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(fd)
        return None
    return fd


# ---------- 知らせ ----------

def slack_escape(text):
    return text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def send(cfg, subject, body, tmp):
    """通知を送る。全部の道で送れたら True（送れない道の中身は出さない）"""
    text = "[{}] {}\n{}".format(cfg["name"], subject, body).strip()
    sent = True
    if cfg["webhook_file"]:
        url = read_webhook(cfg)
        payload = os.path.join(tmp, "payload.json")
        with open(payload, "w", encoding="utf-8") as f:
            # 知らせの中の URL（偽の宛先かもしれない）を Slack に開かせない
            json.dump({"text": slack_escape(text), "unfurl_links": False, "unfurl_media": False}, f, ensure_ascii=False)
        # URL は引数に載せず（ps に出る）、curl の設定として標準入力で渡す。check_url で " \ 空白を断っているので、そのまま書ける
        args = curl_base(cfg, 20) + ["-o", "/dev/null", "-w", "%{http_code}", "-H", "Content-Type: application/json",
                                     "--data-binary", "@" + payload, "-K", "-"]
        try:
            proc = subprocess.run(args, input='url = "{}"\n'.format(url).encode(), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=40)
            code = proc.stdout.decode("ascii", "replace").strip()
        except (OSError, subprocess.TimeoutExpired):
            code = ""
        if not re.match(r"\A2\d\d\Z", code):
            err("Webhook へ送れませんでした（{}）".format("HTTP " + code if code and code != "000" else "接続できない"))
            sent = False
    if cfg["notify_command"]:
        env = dict(os.environ)
        env["EC_SENTINEL_NAME"] = cfg["name"]
        env["EC_SENTINEL_SUBJECT"] = clean("[{}] {}".format(cfg["name"], subject), 200)
        try:
            proc = subprocess.run(["/bin/sh", "-c", cfg["notify_command"]], input=(text + "\n").encode("utf-8"), env=env,
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120)
            ok = proc.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            ok = False
        if not ok:
            err("NOTIFY_COMMAND が失敗しました")
            sent = False
    return sent


# ---------- check ----------

TITLES = {
    "status:fetch": "状態（integrity.json）を {} 回続けて取れません".format(FAILS_BEFORE_ALERT),
    "status:signature": "状態の署名が公開鍵で通りません（書き換えられたか、鍵が替わった）",
    "status:format": "状態の形が違います",
    "status:server": "状態の server が基準と違います（入れ直したか、別のサーバーを見ている。心当たりがあれば accept）",
    "status:problems": "サーバーの内部の整合性チェックが問題を出しています（種類。細かい名前はサーバーで `sudo ec-sugar status`）",
    "status:stale": "状態が古いままです（内部の整合性チェックが止まっている見込み）",
    "status:future": "状態の時刻が先に進みすぎています（時計のずれか、偽造した状態）",
    "status:busy": "更新などの途中（busy）が {} 分を超えています".format(BUSY_SECONDS // 60),
    "run:timeout": "1 回の確認が時間の上限を越えました（遅い応答で監視を遅らせている見込み。見られなかったページは次の回に）",
}
RECOVERED = {
    "status:fetch": "状態を取れるようになりました",
    "status:signature": "状態の署名が通るようになりました",
    "status:format": "状態の形が戻りました",
    "status:server": "状態の server が基準と同じに戻りました",
    "status:problems": "サーバーの内部の整合性チェックの問題が無くなりました",
    "status:stale": "状態の時刻が新しくなりました",
    "status:future": "状態の時刻のずれが無くなりました",
    "status:busy": "更新などの途中（busy）が終わりました",
    "run:timeout": "1 回の確認が時間の上限の中で終わりました",
}
PAGE_PREFIXES = ("page:", "pagefetch:", "baseline:", "pagehidden:", "pagecharset:")


def counted(state, active, unknown, key, title, lines):
    fails = state.setdefault("fails", {})
    fails[key] = fails.get(key, 0) + 1
    if fails[key] >= FAILS_BEFORE_ALERT:
        active[key] = (title, lines, "")
    else:
        unknown.add(key)


def clear(state, key):
    state.setdefault("fails", {}).pop(key, None)


def evaluate_status(cfg, state, tmp, t):
    """状態の問題。active: キー → (題, 詳しい行, 同じ問題か見分ける印)、unknown: 今回は分からないキー、notices: 1 回だけのお知らせ、pending: 送れた時だけ残す値"""
    active, unknown, notices, pending = {}, set(), [], {}
    kind, result = read_status(cfg, tmp)
    status_keys = ("status:signature", "status:format", "status:server", "status:problems", "status:stale", "status:future", "status:busy")
    if kind == "fetch":
        counted(state, active, unknown, "status:fetch", TITLES["status:fetch"], [clean(result)])
        unknown.update(status_keys)
        out("状態を取れません: " + clean(result))
        return active, unknown, notices, pending
    clear(state, "status:fetch")
    if kind == "signature":
        active["status:signature"] = (TITLES["status:signature"], [], "")
        unknown.update(k for k in status_keys if k != "status:signature")
        out("状態の署名が通りません")
        return active, unknown, notices, pending
    if kind == "format":
        active["status:format"] = (TITLES["status:format"], [clean(result)], result)
        unknown.update(k for k in status_keys if k not in ("status:signature", "status:format"))
        out("状態の形が違います: " + result)
        return active, unknown, notices, pending
    s = result
    age = t - s["checked_at"]
    if age > STALE_SECONDS:
        counted(state, active, unknown, "status:stale", TITLES["status:stale"], ["checked_at は約 {} 分前".format(age // 60)])
    else:
        clear(state, "status:stale")
    if age < -FUTURE_SECONDS:
        counted(state, active, unknown, "status:future", TITLES["status:future"], ["checked_at は約 {} 分先".format((-age) // 60)])
    else:
        clear(state, "status:future")

    if state.get("server") is None:
        state["server"] = s["server"]
        state["generation"] = s["generation"]
        out("最初の状態を記録しました（世代 {}）".format(s["generation"]))
    elif state["server"] != s["server"]:
        active["status:server"] = (TITLES["status:server"], [], s["server"])
    else:
        old = state.get("generation")
        if is_int(old) and s["generation"] > old:
            notices.append("基準の状態が変わりました（世代 {} → {}。更新か設定の変更）。心当たりが無ければ調べてください。"
                           "更新の後なら、ショップの基準も accept で取り直してください".format(old, s["generation"]))
        elif is_int(old) and s["generation"] < old:
            notices.append("基準の状態の世代が下がりました（{} → {}）。バックアップから戻した・入れ直した時のほかは、"
                           "古い状態を出し直されている見込みです。調べてください".format(old, s["generation"]))
        if s["generation"] != old:
            pending["generation"] = s["generation"]

    if s["busy"]:
        since = state.get("busy_since")
        since = since if is_int(since) else t
        state["busy_since"] = since
        if t - since >= BUSY_SECONDS:
            active["status:busy"] = (TITLES["status:busy"], ["約 {} 分前から".format((t - since) // 60)], "")
        unknown.add("status:problems")
        out("busy（約 {} 分）".format((t - since) // 60))
    else:
        state["busy_since"] = None
        if not s["ok"]:
            names = s["problems"][:MAX_PROBLEMS] or ["（名前なし）"]
            more = len(s["problems"]) - MAX_PROBLEMS
            lines = [", ".join(names) + ("（ほか {} 件）".format(more) if more > 0 else "")]
            active["status:problems"] = (TITLES["status:problems"], lines, " ".join(s["problems"]))
    out("状態: 世代 {}・ok={}{}・checked_at 約 {} 秒前".format(s["generation"], "true" if s["ok"] else "false",
                                                          "・busy" if s["busy"] else "", age))
    return active, unknown, notices, pending


def evaluate_pages(cfg, state, baseline, tmp):
    active, unknown = {}, set()
    pages = baseline.get("pages", {}) if isinstance(baseline.get("pages"), dict) else {}
    timed_out = False
    for url in cfg["pages"]:
        if url not in pages:
            active["baseline:" + url] = ("ショップの基準がありません。`ec-sugar-sentinel accept <設定>` で取ってください", [url], "")
        if timed_out:
            unknown.update(p + url for p in PAGE_PREFIXES if p != "baseline:")
            continue
        try:
            fp = fingerprint(url, cfg, tmp)
        except TimeLimit:
            timed_out = True
            unknown.update(p + url for p in PAGE_PREFIXES if p != "baseline:")
            out("時間の上限で見られなかった: " + url)
            continue
        except FetchError as e:
            counted(state, active, unknown, "pagefetch:" + url, "ショップのページを {} 回続けて開けません".format(FAILS_BEFORE_ALERT), [url + "（" + clean(e) + "）"])
            unknown.update(("page:" + url, "pagehidden:" + url, "pagecharset:" + url))
            out("開けない: {}（{}）".format(url, clean(e)))
            continue
        clear(state, "pagefetch:" + url)
        if fp["hidden"]:
            mark = hashlib.sha256("\n".join(fp["hidden"]).encode()).hexdigest()
            active["pagehidden:" + url] = ("ショップに、注釈などに隠した要素があります（ブラウザでは動く見込み。スクリプトの差し込みを疑う）",
                                           [url] + ["隠れた: " + h for h in fp["hidden"]], mark)
        if fp["charset"]:
            active["pagecharset:" + url] = ("ショップのページが UTF-8 ではありません（監視とブラウザで解き方が変わる）", [url, fp["charset"]], fp["charset"])
        if url not in pages:
            unknown.add("page:" + url)
            continue
        diff = page_diff(pages[url], fp["entries"])
        if diff:
            mark = hashlib.sha256(json.dumps(fp["entries"], sort_keys=True).encode()).hexdigest()
            active["page:" + url] = ("ショップの指紋が基準と違います（心当たりが無ければ、スクリプトの差し込みを疑う）", [url] + diff, mark)
            out("ショップが基準と違う: {}（{} 件）".format(url, len(diff)))
        else:
            out("ショップ: 基準と同じ: " + url)
    if timed_out:
        active["run:timeout"] = (TITLES["run:timeout"], ["上限 {} 秒（設定 TIME_LIMIT）".format(cfg["time_limit"])], "")
    # 設定から外したページの数を残さない
    fails = state.setdefault("fails", {})
    for key in list(fails):
        if key.startswith("pagefetch:") and key[len("pagefetch:"):] not in cfg["pages"]:
            fails.pop(key)
    return active, unknown


def in_phase(key, phase):
    if phase == "status":
        return key.startswith("status:")
    return key.startswith(PAGE_PREFIXES) or key == "run:timeout"


def known_key(key, cfg):
    for prefix in PAGE_PREFIXES:
        if key.startswith(prefix):
            return key[len(prefix):] in cfg["pages"]
    return True


def recovery_text(key):
    for prefix, text in (("page:", "ショップの指紋が基準と同じに戻りました: "), ("pagefetch:", "ショップのページを開けるようになりました: "),
                         ("pagehidden:", "ショップの隠れた要素が無くなりました: "), ("pagecharset:", "ショップのページが UTF-8 に戻りました: ")):
        if key.startswith(prefix):
            return text + key[len(prefix):]
    return RECOVERED.get(key, key)


def settle(cfg, state, phase, active, unknown, notices, extra_recoveries, t, tmp):
    """1 つの段（状態か店頭）の問題を、通知した印と比べて通知する。送れたら True"""
    opened = state.get("open", {}) if isinstance(state.get("open"), dict) else {}
    new_open = {k: v for k, v in opened.items() if not in_phase(k, phase)}
    alerts, changes, recoveries = [], [], list(extra_recoveries)
    for key, (title, lines, mark) in sorted(active.items()):
        before = opened.get(key)
        if before is None:
            alerts.append((title, lines))
            new_open[key] = {"since": t, "mark": mark}
        else:
            if before.get("mark", "") != mark:
                changes.append((title, lines))
            new_open[key] = {"since": before.get("since", t), "mark": mark}
    for key, before in sorted(opened.items()):
        if not in_phase(key, phase) or key in active or not known_key(key, cfg):
            continue
        if key in unknown:
            new_open[key] = before
            continue
        if key.startswith("baseline:"):
            continue
        since = before.get("since", t) if isinstance(before, dict) else t
        recoveries.append("{}（問題の続いた時間 約 {} 分）".format(recovery_text(key), max(0, (t - since) // 60)))

    sent = True
    if alerts or changes or recoveries or notices:
        parts = []
        for head, items in (("【要対応】", alerts), ("【要対応・中身が変わった】", changes)):
            for title, lines in items:
                parts.append(head + title)
                parts += ["  " + clean(line, 500) for line in lines]
        for line in recoveries:
            parts.append("【戻りました】" + line)
        for line in notices:
            parts.append("【お知らせ】" + line)
        if alerts or changes:
            subject = "要対応 {} 件".format(len(alerts) + len(changes))
        elif recoveries:
            subject = "戻りました"
        else:
            subject = "お知らせ"
        sent = send(cfg, subject, "\n".join(parts), tmp)
        for line in parts:
            out(line)
    # 送れなければ、知らせた印を前のままにして、次の回にもう一度送る
    if sent:
        state["open"] = new_open
    return sent


LOCK_BLOCKED = "lock-blocked-since"
LOCK_NOTIFIED = "lock-blocked-notified"


def lock_blocked(cfg, tmp):
    """ロックが取れない（前の回が終わらない）。LOCK_SECONDS 続いたら 1 回通知して 1 で終わる。状態は前の回が書くので、別のファイルに残す"""
    t = now()
    since_path = os.path.join(cfg["state_dir"], LOCK_BLOCKED)
    notified_path = os.path.join(cfg["state_dir"], LOCK_NOTIFIED)
    since = load_json(since_path, {}).get("since")
    if not is_int(since):
        since = t
        save_json(since_path, {"since": since})
    minutes = (t - since) // 60
    if t - since < LOCK_SECONDS:
        out("前の回がまだ動いています。今回は飛ばします（約 {} 分）".format(minutes))
        return 0
    if not os.path.exists(notified_path):
        ok = send(cfg, "要対応 1 件", "【要対応】前の回の確認が約 {} 分終わりません（遅い応答で止められている・サーバーが詰まっている見込み）。"
                  "監視の記録と、残った ec-sugar-sentinel の処理を見てください".format(minutes), tmp)
        if not ok:
            return 1
        save_json(notified_path, {"since": since})
    out("前の回が約 {} 分終わりません".format(minutes))
    return 1


def lock_recoveries(cfg):
    since_path = os.path.join(cfg["state_dir"], LOCK_BLOCKED)
    notified_path = os.path.join(cfg["state_dir"], LOCK_NOTIFIED)
    lines = []
    if os.path.exists(notified_path):
        since = load_json(notified_path, {}).get("since")
        minutes = max(0, (now() - since) // 60) if is_int(since) else 0
        lines.append("前の回の確認が終わりました（問題の続いた時間 約 {} 分）".format(minutes))
    return lines, (since_path, notified_path)


def run_check(cfg, tmp):
    state_path = os.path.join(cfg["state_dir"], "state.json")
    state = load_json(state_path, {})
    baseline = load_json(os.path.join(cfg["state_dir"], "baseline.json"), {})
    t = now()
    DEADLINE[0] = time.monotonic() + cfg["time_limit"]
    lock_lines, lock_files = lock_recoveries(cfg)
    if os.path.exists(lock_files[0]) and not lock_lines:
        os.unlink(lock_files[0])

    # 1. 様子（ページを見る前に知らせる。遅いページで様子の知らせを遅らせない）
    active_s, unknown_s, notices, pending = evaluate_status(cfg, state, tmp, t)
    sent_s = settle(cfg, state, "status", active_s, unknown_s, notices, lock_lines, t, tmp)
    if sent_s:
        if "generation" in pending:
            state["generation"] = pending["generation"]
        for path in lock_files:
            if os.path.exists(path):
                os.unlink(path)
    state["last_check"] = t
    save_json(state_path, state)

    # 2. 店頭
    active_p, unknown_p = evaluate_pages(cfg, state, baseline, tmp)
    sent_p = settle(cfg, state, "pages", active_p, unknown_p, [], [], t, tmp)
    save_json(state_path, state)

    if not (sent_s and sent_p) or active_s or active_p:
        return 1
    if any(n > 0 for n in state.get("fails", {}).values()):
        out("取れないものがあります（{} 回続けば通知します）".format(FAILS_BEFORE_ALERT))
    else:
        out("ok")
    return 0


# ---------- accept ----------

def run_accept(cfg, tmp, force):
    DEADLINE[0] = time.monotonic() + cfg["time_limit"]
    kind, result = read_status(cfg, tmp)
    if kind == "fetch":
        err("状態を取れません（{}）。STATUS_URL とサーバーを確認してください".format(clean(result)))
        return 1
    if kind == "signature":
        err("状態の署名が公開鍵で通りません。PUBLIC_KEY が `sudo ec-sugar integrity key` の出したものか確認してください")
        return 1
    if kind == "format":
        err("状態の形が違います（{}）".format(result))
        return 1
    # 越えられる断り（--force）: サーバーが困りごとを出している・busy・様子が古いか先・隠れた要素・UTF-8 でない
    refusals = []
    if not result["ok"]:
        refusals.append("サーバーの内部の整合性チェックが問題を出しています（{}{}）".format(", ".join(result["problems"]) or "名前なし",
                                                                               "。busy の途中" if result["busy"] else ""))
    elif result["busy"]:
        out("サーバーは更新などの途中（busy）です。終わってからもう一度 accept すると確かです")
    age = now() - result["checked_at"]
    if age > STALE_SECONDS:
        refusals.append("状態が古いままです（checked_at は約 {} 分前）".format(age // 60))
    if age < -FUTURE_SECONDS:
        refusals.append("状態の時刻が先に進みすぎています（約 {} 分先）".format((-age) // 60))
    baseline_path = os.path.join(cfg["state_dir"], "baseline.json")
    old = load_json(baseline_path, {}).get("pages", {})
    pages = {}
    for url in cfg["pages"]:
        try:
            fp = fingerprint(url, cfg, tmp)
        except FetchError as e:
            err("開けません: {}（{}）。基準は書き換えていません".format(url, clean(e)))
            return 1
        except TimeLimit:
            err("時間の上限（{} 秒）を越えました: {}。基準は書き換えていません".format(cfg["time_limit"], url))
            return 1
        if fp["hidden"]:
            refusals.append("{} に注釈などに隠した要素があります（{}）".format(url, "・".join(fp["hidden"][:5])))
        if fp["charset"]:
            refusals.append("{} が UTF-8 ではありません（{}）".format(url, fp["charset"]))
        pages[url] = fp["entries"]
    if refusals:
        for line in refusals:
            (out if force else err)(("越えます: " if force else "断りました: ") + clean(line, 600))
        if not force:
            err("先に調べてから accept してください（調べた上で取るなら --force）。基準は書き換えていません")
            return 1
    for url in cfg["pages"]:
        out("== " + url)
        if isinstance(old, dict) and url in old:
            diff = page_diff(old[url], pages[url])
            for line in diff or ["前の基準と同じ"]:
                out("  " + line)
        else:
            for entry in pages[url]:
                out("  " + render(entry))
    save_json(baseline_path, {"accepted_at": now(), "pages": pages})
    state_path = os.path.join(cfg["state_dir"], "state.json")
    state = load_json(state_path, {})
    state["server"] = result["server"]
    state["generation"] = result["generation"]
    opened = state.get("open", {}) if isinstance(state.get("open"), dict) else {}
    state["open"] = {k: v for k, v in opened.items() if not k.startswith(("page:", "baseline:")) and k != "status:server"}
    save_json(state_path, state)
    out("基準を取りました（ページ {}・世代 {}）".format(len(pages), result["generation"]))
    return 0


def main():
    cmd, conf, force = sys.argv[1], sys.argv[2], sys.argv[3] == "--force"
    if not OPENSSL or not CURL:
        err("ec-sugar-sentinel の bash の部分から実行してください")
        return 2
    try:
        cfg = load_config(conf)
        check_public_key(cfg["public_key"])
        open_state_dir(cfg["state_dir"])
        if cfg["webhook_file"]:
            read_webhook(cfg)
        read_token(cfg)
    except ConfigError as e:
        err("設定の誤り: " + str(e))
        return 2
    os.umask(0o077)
    tmp = tempfile.mkdtemp(prefix="ec-sugar-sentinel-")
    lock = None
    try:
        lock = take_lock(cfg["state_dir"])
        if lock is None:
            return lock_blocked(cfg, tmp) if cmd == "check" else (err("前の回がまだ動いています") or 1)
        if cmd == "check":
            return run_check(cfg, tmp)
        if cmd == "accept":
            return run_accept(cfg, tmp, force)
        ok = send(cfg, "テスト通知です（ec-sugar-sentinel test-notify）", "この通知が届けば、外部監視の通知先は使えます。", tmp)
        out("送りました" if ok else "送れませんでした")
        return 0 if ok else 1
    except ConfigError as e:
        err("設定の誤り: " + str(e))
        return 2
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
        if lock is not None:
            os.close(lock)


sys.exit(main())
