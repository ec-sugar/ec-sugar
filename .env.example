APP_NAME=EC-SUGAR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP
APP_TIMEZONE=Asia/Tokyo

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 中央 DB（Tenant / ドメイン / 契約 / 管理者）。テナント DB は tenancy が同じサーバー上に作る
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ec_central
DB_USERNAME=ec_app
DB_PASSWORD=ec_dev_only

# テナント DB の命名（tenancy）
TENANT_DB_PREFIX=ec_t_
TENANT_DB_SUFFIX=

# 中央（管理・API 入口）のホスト名。テナントの店頭はこれ以外のホストで受ける
CENTRAL_DOMAINS=localhost,127.0.0.1

# 運営の管理画面（ADR 0013）。本番では ADMIN_ALLOWED_IPS を必ず設定する
ADMIN_DOMAIN=admin.localhost
ADMIN_URL=http://admin.localhost:8080
ADMIN_ALLOWED_IPS=
# 信じる前段の代理（X-Forwarded-For を伝えてくる相手）。既定は無し。nginx から PHP は直結なので代理ではない。前にロードバランサを置いたときだけその住所
TRUSTED_PROXIES=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
# キューは店の接頭辞の付かない専用の接続 queue（config/database.php）を使う。REDIS_QUEUE_CONNECTION を default や cache にしない（すると起動で止まる）

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3 互換ストレージ（開発は MinIO）。画像は別オリジンから配信する（7.2）
AWS_ACCESS_KEY_ID=ec
AWS_SECRET_ACCESS_KEY=ec_dev_only
AWS_DEFAULT_REGION=ap-northeast-1
AWS_BUCKET=ec-sugar
AWS_ENDPOINT=http://storage:9000
AWS_URL=http://localhost:9000/ec-sugar
AWS_USE_PATH_STYLE_ENDPOINT=true

# 商品とショップの写真の置き場（storage/app/<名前>）。環境ごとに分ける（テストは media-testing、ブラウザのテストは media-e2e。作業ごとに分けるときは media-testing-<文字>・media-e2e-<文字>）
MEDIA_DIRECTORY=media
# 売るファイル（App「ダウンロード販売」）は storage/app/<MEDIA_DIRECTORY>-downloads（写真と別。外から直接は見えない）。
# 1 つの大きさと店ごとの合計の上限（MB。私たちがホストする時の上限。空なら 500 と 10240）
#DOWNLOADS_MAX_FILE_MB=500
#DOWNLOADS_SHOP_QUOTA_MB=10240

VITE_APP_NAME="${APP_NAME}"

# 「Stripe とつなぐ」（SaaS 版、ADR 0022）。運営の Stripe のプラットフォームの秘密鍵と、連結アカウントの通知の署名の鍵。
# パッケージ版は空のまま（店が管理画面で自分の鍵を貼る）
STRIPE_PLATFORM_SECRET_KEY=
STRIPE_CONNECT_WEBHOOK_SECRET=
